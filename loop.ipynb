    "\n",
    "# prime numbers\n",
    "n = 12\n",
    "\n",
    "for i in range(2, n):              \n",
    "    for j in range(2, i):          \n",
    "        if i % j == 0:\n",
    "            break                  \n",
    "    else:                          \n",
    "        print(i, end=\" \")  \n",
    "\n"
